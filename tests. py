    assert drastic.get_d_rating(1.5) == 10
    assert drastic.get_d_rating(1.6) == 9
    assert drastic.get_d_rating(4.6) == 9
    assert drastic.get_d_rating(4.7) == 7
    assert drastic.get_d_rating(15.2) == 5
    assert drastic.get_d_rating(22.9) == 3
    assert drastic.get_d_rating(30.5) == 2
    assert drastic.get_d_rating(31.0) == 1
    assert drastic.get_d_rating(100.0) == 1
    print("[PASS] test_d_rating_boundaries")


def test_d_rating_negative():
    """اختبار رفض القيم السالبة."""
    try:
        drastic.get_d_rating(-1)
        assert False, "Should raise ValueError"
    except ValueError:
        pass
    print("[PASS] test_d_rating_negative")


