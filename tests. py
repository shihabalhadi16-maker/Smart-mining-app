# اختبارات Travel Time (Darcy)
# ============================================================
def test_travel_time_basic():
    result = drastic.calc_travel_time(depth_m=10, porosity=0.25, conductivity=5)
    assert "days" in result
    assert "years" in result
    assert "velocity" in result
    # v = (5 * 1) / 0.25 = 20 m/day
    assert result["velocity"] == 20.0
    # days = 10 / 20 = 0.5
    assert result["days"] == 0.5
    print(f"[PASS] test_travel_time_basic (velocity={result['velocity']} m/day)")


def test_travel_time_invalid():
    try:
        drastic.calc_travel_time(10, 0.005, 5)
        assert False
    except ValueError:
        pass
    try:
        drastic.calc_travel_time(-5, 0.25, 5)
        assert False
    except ValueError:
        pass
    print("[PASS] test_travel_time_invalid")


