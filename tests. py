# اختبارات Mitigation
# ============================================================
def test_mitigation_hdpe_only():
    result = drastic.mitigate(160, hdpe=True)
    assert result["mitigated_index"] == 64.0  # 160 * 0.40
    assert result["reduction_pct"] == 60.0
    print("[PASS] test_mitigation_hdpe_only")


def test_mitigation_all():
    result = drastic.mitigate(200, hdpe=True, treatment=True, monitoring=True)
    expected = 200 * 0.40 * 0.60 * 0.85
    assert abs(result["mitigated_index"] - round(expected, 1)) < 0.2
    assert len(result["methods"]) == 3
    print(f"[PASS] test_mitigation_all ({result['mitigated_index']})")


def test_mitigation_none():
    result = drastic.mitigate(150)
    assert result["mitigated_index"] == 150.0
    assert result["reduction_pct"] == 0.0
    print("[PASS] test_mitigation_none")


