# ============================================================
# تشغيل جميع الاختبارات
# ============================================================
def run_all_tests():
    """تشغيل جميع الاختبارات يدوياً."""
    print("=" * 60)
    print("DRASTIC Sudan - Unit Tests")
    print("=" * 60)
    print()
    
    tests = [
        test_d_rating_boundaries,
        test_d_rating_negative,
        test_r_rating_boundaries,
        test_aquifer_rating,
        test_soil_rating,
        test_vadose_rating,
        test_topography_rating,
        test_conductivity_rating,
        test_index_minimum,
        test_index_maximum,
        test_index_typical,
        test_index_invalid,
        test_classification,
        test_classification_boundaries,
        test_travel_time_basic,
        test_travel_time_invalid,
        test_mitigation_hdpe_only,
        test_mitigation_all,
        test_mitigation_none,
        test_sensitivity_analysis,
        test_module_info,
    ]
    
    passed = 0
    failed = 0
    
    for test in tests:
        try:
            test()
            passed += 1
        except AssertionError as e:
            print(f"[FAIL] {test.__name__}: {e}")
            failed += 1
        except Exception as e:
            print(f"[ERROR] {test.__name__}: {e}")
            failed += 1
    
    print()
    print("=" * 60)
    print(f"Results: {passed} passed, {failed} failed")
    print(f"Total: {len(tests)} tests")
    print("=" * 60)
    
    return failed == 0


if __name__ == "__main__":
    success = run_all_tests()
    exit(0 if success else 1)
