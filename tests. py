# اختبارات Index Calculation
# ============================================================
def test_index_minimum():
    """الحد الأدنى: كل القيم = 1."""
    idx = drastic.calc_index(1, 1, 1, 1, 1, 1, 1)
    assert idx == 23, f"Expected 23, got {idx}"
    print("[PASS] test_index_minimum (23)")


def test_index_maximum():
    """الحد الأقصى: كل القيم = 10."""
    idx = drastic.calc_index(10, 10, 10, 10, 10, 10, 10)
    assert idx == 230, f"Expected 230, got {idx}"
    print("[PASS] test_index_maximum (230)")


def test_index_typical():
    """حالة نموذجية."""
    idx = drastic.calc_index(5, 3, 6, 9, 4, 8, 5)
    expected = (5*5) + (3*4) + (6*3) + (9*2) + (4*1) + (8*5) + (5*3)
    assert idx == expected, f"Expected {expected}, got {idx}"
    print(f"[PASS] test_index_typical ({idx})")


def test_index_invalid():
    """اختبار رفض القيم غير الصحيحة."""
    try:
        drastic.calc_index(0, 1, 1, 1, 1, 1, 1)
        assert False, "Should raise for 0"
    except ValueError:
        pass
    try:
        drastic.calc_index(11, 1, 1, 1, 1, 1, 1)
        assert False, "Should raise for 11"
    except ValueError:
        pass
    print("[PASS] test_index_invalid")


