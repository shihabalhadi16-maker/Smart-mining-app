        "range": [DRASTIC_MIN_INDEX, DRASTIC_MAX_INDEX],
        "functions": [
            "get_d_rating", "get_r_rating", "get_a_rating",
            "get_s_rating", "get_t_rating", "get_i_rating",
            "get_c_rating", "calc_index", "classify",
            "calc_travel_time", "mitigate", "sensitivity_analysis",
        ],
    }
