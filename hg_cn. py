"""
Hg & CN Analysis Module
========================
وحدة تحليل الزئبق والسيانيد + نظام التنبيهات

References:
    - Minamata Convention on Mercury (2017)
    - International Cyanide Management Code (ICMC, 2002)
    - WHO (2022). Guidelines for Drinking-water Quality
    - US EPA (2020). Mercury and Air Toxics Standards

Version: 1.0.0
"""

from typing import Dict, Any, List
import datetime

__version__ = "1.0.0"


# ============================================================
# الحدود الدولية
# ============================================================
WHO_LIMITS = {
    "mercury_inorganic_mg_L": {"limit": 0.006, "source": "WHO (2022)"},
    "mercury_total_mg_L": {"limit": 0.001, "source": "WHO (2022)"},
    "cyanide_free_mg_L": {"limit": 0.07, "source": "WHO (2022)"},
    "cyanide_total_mg_L": {"limit": 0.07, "source": "WHO (2022)"},
    "mercury_soil_mg_kg": {"limit": 1.0, "source": "Minamata Convention"},
    "cyanide_soil_mg_kg": {"limit": 10.0, "source": "ICMC (2002)"},
}


# ============================================================
# 1. تحليل الزئبق
# ============================================================
def analyze_mercury(water_mg_L: float, soil_mg_kg: float) -> Dict[str, Any]:
    """
    تحليل تركيز الزئبق مقابل المعايير الدولية.

    Args:
        water_mg_L: تركيز الزئبق في المياه (mg/L)
        soil_mg_kg: تركيز الزئبق في التربة (mg/kg)

    Returns:
        dict مع التحليل الكامل
    """
    water_limit = WHO_LIMITS["mercury_inorganic_mg_L"]["limit"]
    soil_limit = WHO_LIMITS["mercury_soil_mg_kg"]["limit"]

    water_status = "safe" if water_mg_L <= water_limit else "exceeded"
    soil_status = "safe" if soil_mg_kg <= soil_limit else "exceeded"

    water_ratio = water_mg_L / water_limit if water_limit > 0 else 0
    soil_ratio = soil_mg_kg / soil_limit if soil_limit > 0 else 0

    # تصنيف الخطورة
    max_ratio = max(water_ratio, soil_ratio)
    if max_ratio <= 1.0:
        toxicity_level = "منخفض"
        toxicity_color = "green"
    elif max_ratio <= 3.0:
        toxicity_level = "متوسط"
        toxicity_color = "yellow"
    elif max_ratio <= 10.0:
        toxicity_level = "مرتفع"
        toxicity_color = "orange"
    else:
        toxicity_level = "مرتفع جدا"
        toxicity_color = "red"

    return {
        "water": {
            "value": water_mg_L,
            "limit": water_limit,
            "status": water_status,
            "ratio": round(water_ratio, 2),
            "source": WHO_LIMITS["mercury_inorganic_mg_L"]["source"],
        },
        "soil": {
            "value": soil_mg_kg,
            "limit": soil_limit,
            "status": soil_status,
            "ratio": round(soil_ratio, 2),
            "source": WHO_LIMITS["mercury_soil_mg_kg"]["source"],
        },
        "toxicity_level": toxicity_level,
        "toxicity_color": toxicity_color,
        "max_ratio": round(max_ratio, 2),
    }


