def init_lang():
    """تهيئة اللغة."""
    if "lang" not in st.session_state:
        st.session_state["lang"] = "ar"


def t(key: str) -> str:
    """ترجمة مفتاح."""
    lang = st.session_state.get("lang", "ar")
    return TRANSLATIONS.get(lang, TRANSLATIONS["ar"]).get(
        key, key)


def get_current() -> str:
    """اللغة الحالية."""
    return st.session_state.get("lang", "ar")


def get_module_info() -> dict:
    return {"name": "Language Module", "version": __version__,
            "languages": ["ar", "en"]}
