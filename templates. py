def get_applicable_legislation(activity_type: str) -> Dict[str, List[Any]]:
    """
    ترجع القوانين المطبقة حسب نوع النشاط التعديني.
    
    Args:
        activity_type (str): نوع النشاط، أحد الخيارات:
            - "traditional_mining": التعدين التقليدي
            - "industrial_mining": التعدين الصناعي
            - "processing": المعالجة والتكرير
    
    Returns:
        dict: يحتوي على:
            - national_laws: قائمة القوانين المطبقة
            - international_agreements: قائمة الاتفاقيات المطبقة
            - technical_standards: قائمة المعايير المطبقة
            
    Raises:
        ValueError: إذا كان activity_type غير معروف أو غير مدعوم.
    """
    valid_types = ["traditional_mining", "industrial_mining", "processing"]
    
    if not isinstance(activity_type, str) or activity_type.strip().lower() not in valid_types:
        raise ValueError(
            f"نوع النشاط غير معروف: '{activity_type}'. الخيارات المتاحة هي: {valid_types} / "
            f"Unknown activity_type: '{activity_type}'. Valid options are: {valid_types}"
        )
    
    act_type = activity_type.strip().lower()
    nat_laws = SUDAN_MINING_LEGISLATIONS["national_laws"]
    intl_agreements = SUDAN_MINING_LEGISLATIONS["international_agreements"]
    tech_standards = SUDAN_MINING_LEGISLATIONS["technical_standards"]
    
    result: Dict[str, List[Any]] = {
        "national_laws": [],
        "international_agreements": [],
        "technical_standards": []
    }
    
    if act_type == "traditional_mining":
        # التعدين التقليدي: لائحة 2016 + قانون 2015 + قانون البيئة 2001
        result["national_laws"] = [
            nat_laws["traditional_mining_reg_2016"],
            nat_laws["mining_act_2015"],
            nat_laws["environmental_act_2001"]
        ]
        result["international_agreements"] = [
            intl_agreements["minamata_convention"]
        ]
        result["technical_standards"] = []
        
    elif act_type == "industrial_mining":
        # التعدين الصناعي: قانون 2015 + لائحة 2018 + كل الاتفاقيات الدولية
        result["national_laws"] = [
            nat_laws["mining_act_2015"],
            nat_laws["mineral_exploitation_reg_2018"]
        ]
        result["international_agreements"] = list(intl_agreements.values())
        result["technical_standards"] = list(tech_standards.values())
        
    elif act_type == "processing":
        # المعالجة والتكرير: قانون 2015 + قانون الصحة 2009 + Minamata + Cyanide Code
        result["national_laws"] = [
            nat_laws["mining_act_2015"],
            nat_laws["environmental_health_act_2009"]
        ]
        result["international_agreements"] = [
            intl_agreements["minamata_convention"],
            intl_agreements["cyanide_code"]
        ]
        result["technical_standards"] = [
            tech_standards["iso_14001"]
        ]
        
    return result
