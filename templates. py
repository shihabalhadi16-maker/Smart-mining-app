def get_template_key(drastic_index):
    if drastic_index >= 180: return "very_high"
    if drastic_index >= 140: return "high"
    if drastic_index >= 100: return "moderate"
    return "low"


def get_template_content(key):
    m = {"low": CONTENT_LOW, "moderate": CONTENT_MODERATE,
         "high": CONTENT_HIGH, "very_high": CONTENT_VERY_HIGH}
    return m.get(key, CONTENT_LOW)


def generate_report(site_name, coordinates, drastic_index, ratings, values, travel_time_years=None):
    key = get_template_key(drastic_index)
    meta = TEMPLATE_METADATA[key]
    content = get_template_content(key)
    today = datetime.date.today()
    ref = f"GRAS-ENV-{today.strftime('%Y%m%d')}-{key.upper()[:3]}"
    
    L = []
    L.append("=" * 68)
    L.append("تقرير تقييم هشاشة المياه الجوفية")
    L.append("جامعة الخرطوم — كلية الهندسة")
    L.append("=" * 68)
    L.append("")
    L.append(f"الرقم المرجعي: {ref}")
    L.append(f"التاريخ: {today.strftime('%Y-%m-%d')}")
    L.append(f"القالب: {meta['id']} — الإصدار {meta['version']}")
    L.append("")
    L.append("-" * 68)
    L.append("القسم 1: بيانات الموقع")
    L.append("-" * 68)
    L.append(f"اسم الموقع: {site_name}")
    L.append(f"الإحداثيات: {coordinates[0]:.4f}, {coordinates[1]:.4f}")
    L.append("")
    L.append("-" * 68)
    L.append("القسم 2: نتائج DRASTIC")
    L.append("-" * 68)
    L.append(f"مؤشر DRASTIC: {drastic_index} / 230")
    L.append(f"مستوى الخطورة: {meta['level']}")
    L.append("")
    L.append(f"  D — عمق المياه: {values.get('depth', 'N/A')} م → {ratings.get('D', 'N/A')}")
    L.append(f"  R — التغذية: {values.get('recharge', 'N/A')} مم/سنة → {ratings.get('R', 'N/A')}")
    L.append(f"  A — الخزان: {values.get('aquifer', 'N/A')} → {ratings.get('A', 'N/A')}")
    L.append(f"  S — التربة: {values.get('soil', 'N/A')} → {ratings.get('S', 'N/A')}")
    L.append(f"  T — الانحدار: {values.get('slope', 'N/A')}% → {ratings.get('T', 'N/A')}")
    L.append(f"  I — غير المشبعة: {values.get('vadose', 'N/A')} → {ratings.get('I', 'N/A')}")
    L.append(f"  C — النفاذية: {values.get('conductivity', 'N/A')} م/يوم → {ratings.get('C', 'N/A')}")
    L.append("")
    
    if travel_time_years is not None:
        L.append(f"زمن وصول الملوثات: {travel_time_years:.2f} سنة")
        L.append("")
    
    L.append("-" * 68)
    L.append("القسم 3: التقييم الهيدروجيولوجي")
    L.append("-" * 68)
    L.append(content["hydro_assessment"])
    L.append("")
    L.append("-" * 68)
    L.append("القسم 4: التوصيات")
