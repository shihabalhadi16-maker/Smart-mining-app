def get_template_key(index):
    if index >= 180: return "very_high"
    if index >= 140: return "high"
    if index >= 100: return "moderate"
    return "low"


def generate_report(site_name, coordinates, drastic_index, ratings, values, travel_time_years=None):
    key = get_template_key(drastic_index)
    meta = TEMPLATE_METADATA[key]
    text = TEXT[key]
    today = datetime.date.today()
    
    lines = []
    lines.append("=" * 60)
    lines.append("تقرير تقييم هشاشة المياه الجوفية")
    lines.append("جامعة الخرطوم - كلية الهندسة")
    lines.append("=" * 60)
    lines.append("")
    lines.append(f"الرقم المرجعي: GRAS-{today.strftime('%Y%m%d')}-{key.upper()[:3]}")
    lines.append(f"التاريخ: {today.strftime('%Y-%m-%d')}")
    lines.append(f"القالب: {meta['id']}")
    lines.append("")
    lines.append("-" * 60)
    lines.append("بيانات الموقع")
    lines.append("-" * 60)
    lines.append(f"الاسم: {site_name}")
    lines.append(f"الإحداثيات: {coordinates[0]:.4f}, {coordinates[1]:.4f}")
    lines.append("")
    lines.append("-" * 60)
    lines.append("نتائج DRASTIC")
    lines.append("-" * 60)
    lines.append(f"المؤشر: {drastic_index} / 230")
    lines.append(f"المستوى: {meta['level']} ({meta['range']})")
    lines.append("")
    lines.append(f"D - العمق: {values.get('depth', 'N/A')} م → {ratings.get('D', 'N/A')}")
    lines.append(f"R - التغذية: {values.get('recharge', 'N/A')} مم → {ratings.get('R', 'N/A')}")
    lines.append(f"A - الخزان: {values.get('aquifer', 'N/A')} → {ratings.get('A', 'N/A')}")
    lines.append(f"S - التربة: {values.get('soil', 'N/A')} → {ratings.get('S', 'N/A')}")
    lines.append(f"T - الانحدار: {values.get('slope', 'N/A')}% → {ratings.get('T', 'N/A')}")
    lines.append(f"I - غير المشبعة: {values.get('vadose', 'N/A')} → {ratings.get('I', 'N/A')}")
    lines.append(f"C - النفاذية: {values.get('conductivity', 'N/A')} → {ratings.get('C', 'N/A')}")
    lines.append("")
    
    if travel_time_years:
        lines.append(f"زمن وصول الملوثات: {travel_time_years:.2f} سنة")
        lines.append("")
    
    lines.append("-" * 60)
    lines.append("التقييم الهيدروجيولوجي")
    lines.append("-" * 60)
    lines.append(text["assessment"])
    lines.append("")
    lines.append("-" * 60)
    lines.append("التوصيات")
    lines.append("-" * 60)
    for i, rec in enumerate(text["recs"], 1):
        lines.append(f"{i}. {rec}")
    lines.append("")
    lines.append("-" * 60)
    lines.append("الامتثال التشريعي")
    lines.append("-" * 60)
    lines.append("- المادة (26) قانون التعدين 2015")
    lines.append("- قانون حماية البيئة 2001 (رقم 18)")
    lines.append("- لائحة التعدين التقليدي 2016")
    lines.append("- WHO (2022)")
    lines.append("")
    lines.append("-" * 60)
    lines.append("المراجع")
    lines.append("-" * 60)
    lines.append("1. Aller et al. (1987). EPA/600/2-87/035")
    lines.append("2. Fetter (2001). Applied Hydrogeology, 4th ed.")
    lines.append("3. US EPA (1993). EPA/600/R-93/174")
    lines.append("4. WHO (2022). Guidelines for Drinking-water Quality")
    lines.append("")
    lines.append("-" * 60)
    lines.append("المراجعة والاعتماد")
    lines.append("-" * 60)
    lines.append("هذا التقرير مُولَّد آلياً. لا يُعتمد رسمياً")
    lines.append("إلا بعد مراجعة وتوقيع مهندس مختص.")
    lines.append("")
    lines.append("اسم المهندس: _______________________")
    lines.append("الرقم الوظيفي: _______________________")
    lines.append("التاريخ: ___/___/______")
    lines.append("التوقيع: _______________________")
    lines.append("")
    lines.append("=" * 60)
    lines.append("© 2026 جامعة الخرطوم")
    lines.append("=" * 60)
    
    return "\n".join(lines)
