# ============ 1. وحدة التحقق الفعلي (Validation Module) ============
# ============================================================
def calculate_confusion_matrix(predicted, actual, threshold=140):
    """
    حساب مصفوفة الالتباس (Confusion Matrix) مع المقاييس الإحصائية
    
    Parameters:
    -----------
    predicted : array-like - قيم المؤشر المتوقعة
    actual : array-like - الحالة الفعلية (1 = ملوث، 0 = نظيف)
    threshold : int - عتبة التصنيف (افتراضي 140)
    
    Returns:
    --------
    dict: جميع مقاييس الدقة
    """
    predicted = np.array(predicted)
    actual = np.array(actual)
    pred_class = (predicted >= threshold).astype(int)
    
    tp = int(np.sum((pred_class == 1) & (actual == 1)))
    tn = int(np.sum((pred_class == 0) & (actual == 0)))
    fp = int(np.sum((pred_class == 1) & (actual == 0)))
    fn = int(np.sum((pred_class == 0) & (actual == 1)))
    
    total = tp + tn + fp + fn
    
    # المقاييس الأساسية
    accuracy = (tp + tn) / total if total > 0 else 0
    precision = tp / (tp + fp) if (tp + fp) > 0 else 0
    recall = tp / (tp + fn) if (tp + fn) > 0 else 0
    specificity = tn / (tn + fp) if (tn + fp) > 0 else 0
    f1 = (2 * precision * recall / (precision + recall)) if (precision + recall) > 0 else 0
    npv = tn / (tn + fn) if (tn + fn) > 0 else 0  # Negative Predictive Value
    
    # Cohen's Kappa
    po = accuracy
    pe = ((tp + fp) * (tp + fn) + (tn + fn) * (tn + fp)) / (total ** 2) if total > 0 else 0
    kappa = ((po - pe) / (1 - pe)) if (1 - pe) > 0 else 0
    
    # Matthews Correlation Coefficient
    mcc_num = (tp * tn) - (fp * fn)
    mcc_den = np.sqrt((tp + fp) * (tp + fn) * (tn + fp) * (tn + fn))
    mcc = mcc_num / mcc_den if mcc_den > 0 else 0
    
    # ROC-AUC (تبسيط)
    tpr = recall
    fpr = fp / (fp + tn) if (fp + tn) > 0 else 0
    youden_j = tpr - fpr
    
    # Balanced Accuracy
    balanced_acc = (recall + specificity) / 2
    
    return {
        "confusion_matrix": {
            "TP": tp, "TN": tn, "FP": fp, "FN": fn,
            "Total": total
        },
        "accuracy": round(accuracy * 100, 2),
        "precision": round(precision * 100, 2),
        "recall": round(recall * 100, 2),
        "specificity": round(specificity * 100, 2),
        "f1_score": round(f1 * 100, 2),
        "npv": round(npv * 100, 2),
        "balanced_accuracy": round(balanced_acc * 100, 2),
        "kappa": round(kappa, 4),
        "mcc": round(mcc, 4),
        "youden_j": round(youden_j, 4),
        "threshold": threshold
    }


def analyze_validation_by_level(predicted, actual, thresholds=None):
    """
    تحليل التحقق حسب مستويات DRASTIC
    
    Returns:
    --------
    DataFrame: دقة التصنيف لكل مستوى
    """
    if thresholds is None:
        thresholds = [100, 140, 180]
    
    predicted = np.array(predicted)
    actual = np.array(actual)
    
    levels = []
    for i, idx in enumerate(predicted):
        if idx < 100: level = "منخفض"
        elif idx < 140: level = "متوسط"
        elif idx < 180: level = "مرتفع"
        else: level = "مرتفع جدا"
        levels.append(level)
    
    df = pd.DataFrame({
        "predicted_index": predicted,
        "actual": actual,
        "level": levels
    })
    
    # حساب الدقة لكل مستوى
    results = []
    for level in ["منخفض", "متوسط", "مرتفع", "مرتفع جدا"]:
        subset = df[df["level"] == level]
        if len(subset) > 0:
            # في المستويات المرتفعة: نتوقع actual=1
            if level in ["مرتفع", "مرتفع جدا"]:
                correct = (subset["actual"] == 1).sum()
            elif level == "منخفض":
                correct = (subset["actual"] == 0).sum()
            else:  # متوسط - لا نتوقع
                correct = 0
            
            results.append({
                "المستوى": level,
                "العدد": len(subset),
                "التصنيفات الصحيحة": int(correct),
                "نسبة الدقة": round(correct / len(subset) * 100, 1)
                           if len(subset) > 0 else 0
            })
    
    return pd.DataFrame(results)


